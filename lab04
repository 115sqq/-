#include <stdio.h>  
#define MAX 100  
int main()  
{  
    int n, i, j, key;  
    int a[MAX];  
    printf("Введите количество элементов (1..%d): ", MAX);  
    if (scanf("%d", &n) != 1 || n < 1 || n > MAX) {  
        printf("Некорректный размер массива\n");  
        return 1;  
    }  
    for (i = 0; i < n; i++) {  
        printf("a[%d] = ", i);  
        scanf("%d", &a[i]);  
    }  
    for (i = 1; i < n; i++) {  
        key = a[i];  
        j = i - 1;  
        while (j >= 0 && a[j] > key) {  
            a[j + 1] = a[j];  
            j--;  
        } 
        a[j + 1] = key;  
    }  
    printf("Отсортированный массив:");  
    for (i = 0; i < n; i++) {  
        printf(" %d", a[i]);  
    } 
    printf("\n");  
    return 0;  
} 
