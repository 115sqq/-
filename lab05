#include <stdio.h>  
#define MAX 100  
int main(void) {  
    int n, i, max, second, found = 0, is_palindrome = 1;  
    int a[MAX];  
    printf("Введите количество элементов (1..%d): ", MAX);  
    if (scanf("%d", &n) != 1 || n < 1 || n > MAX) {  
        printf("Некорректный размер массива\n");  
        return 1;  
    }  
    for (i = 0; i < n; i++) {  
        printf("a[%d] = ", i);  
        scanf("%d", &a[i]);  
    }  
    for (i = 0; i < n / 2; i++) {  
        if (a[i] != a[n - 1 - i]) {  
            is_palindrome = 0;  
            break;  
        }  
    }  
    if (is_palindrome) {  
        printf("Массив является палиндромом\n");  
    } else {  
        printf("Массив не является палиндромом\n");  
    }   
    max = a[0];  
    for (i = 1; i < n; i++) {  
        if (a[i] > max) {  
            max = a[i];  
        }  
    }  
    second = max;  
    for (i = 0; i < n; i++) {  
        if (a[i] < max && (!found || a[i] > second)) {  
            second = a[i];  
          found = 1;  
        }  
    }  
    if (found) {  
        printf("Второй по величине элемент: %d\n", second);  
    } else {  
        printf("Все элементы одинаковы, второго по величине нет\n");  
    }  
    return 0;  
} 
