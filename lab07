#include <stdio.h> 
int main(void) 
{ 
    int num, work, sum; 
    do { 
        do { 
            printf("Введите положительное целое число: "); 
            if (scanf("%d", &num) != 1) { 
                printf("Ошибка ввода\n"); 
                return 1; 
            } 
            if (num <= 0) { 
                printf("Число должно быть положительным.\n"); 
            } 
        } while (num <= 0); 
        sum = 0; 
        work = num; 
        while (work > 0) { 
            sum += work % 10; 
            work /= 10; 
        } 
        printf("Сумма цифр: %d\n", sum); 
    } while (sum > 10); 
    printf("Программа завершена.\n"); 
    return 0; 
} 
